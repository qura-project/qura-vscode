{
  "name": "qura-language",
  "displayName": "QuRA Language Support",
  "description": "Syntax highlighting for the QuRA quantum programming language",
  "version": "0.1.0",
  "publisher": "qura-project",
  "license": "MIT",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "repository": { "type": "git", "url": "https://github.com/qura-project/qura" },
  "contributes": {
    "languages": [
      {
        "id": "qura",
        "aliases": ["QuRA", "qura"],
        "extensions": [".qura"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qura",
        "scopeName": "source.qura",
        "path": "./syntaxes/qura.tmLanguage.json"
      }
    ]
  }
}
